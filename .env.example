# Ajan ayarları şablonu. Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore'dadır; git onu görmez, GitHub'a gitmez. Bu şablona gerçek anahtar YAZMAYIN.
#
# Anahtar: https://aistudio.google.com/apikey -> "Create API key"
GEMINI_API_KEY=
# Model adı (isteğe bağlı; boşsa gemini-2.5-flash). Güncel liste: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
